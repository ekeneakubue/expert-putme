generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
}

enum AnswerKey {
  A
  B
  C
  D
}

/// Control-room staff (admin dashboard users)
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

/// JAMB candidates who register for the mock
model Candidate {
  id           String          @id @default(cuid())
  fullName     String
  jambReg      String          @unique
  phone        String
  passwordHash String
  enrollment   MockEnrollment?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([phone])
  @@map("candidates")
}

/// Paid (or pending) mock subscription for a candidate
model MockEnrollment {
  id           String        @id @default(cuid())
  candidateId  String        @unique
  candidate    Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  subjectIds   String[]
  paid         Boolean       @default(false)
  paidAt       DateTime?
  amount       Int           @default(1000)
  reference    String?
  attemptsUsed Int           @default(0)
  attempts     MockAttempt[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("mock_enrollments")
}

/// Individual CBT sits under a mock subscription
model MockAttempt {
  id           String         @id @default(cuid())
  enrollmentId String
  enrollment   MockEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  attemptNumber Int
  correct      Int
  attempted    Int
  total        Int
  percent      Int
  subjects     Json
  submittedAt  DateTime

  @@unique([enrollmentId, attemptNumber])
  @@index([enrollmentId])
  @@map("mock_attempts")
}

/// Exam subjects available for the mock paper
model Subject {
  id        String     @id @default(cuid())
  name      String     @unique
  questions Question[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("subjects")
}

/// CBT question bank items, scoped to a subject
model Question {
  id        String    @id @default(cuid())
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  prompt    String
  optionA   String
  optionB   String
  optionC   String
  optionD   String
  answer    AnswerKey
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([subjectId])
  @@map("questions")
}
